 	{ .compatible = "marvell,armada-380-neta-bm" },
 	{ }
@@ -491,6 +562,7 @@ static struct platform_driver mvneta_bm_driver = {
 	.driver = {
 		.name = MVNETA_BM_DRIVER_NAME,
 		.of_match_table = mvneta_bm_match,
