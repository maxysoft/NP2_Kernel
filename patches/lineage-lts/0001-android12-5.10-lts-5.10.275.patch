-	case WIFI_CTRL_TYPE:/*ctrl*/
-		retval = validate_recv_ctrl_frame(adapter, precv_frame);
-		break;
-	case WIFI_DATA_TYPE: /*data*/
-		pattrib->qos = (subtype & BIT(7)) ? 1 : 0;
