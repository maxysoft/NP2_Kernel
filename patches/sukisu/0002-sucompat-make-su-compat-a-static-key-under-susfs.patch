Subject: sucompat: define ksu_su_compat_enabled as the static key the SUSFS patch expects; switch only the su rewrite
Base: SukiSU-Nova builtin @ 4bec532dd447e2852aa8932afa768255350c103a

diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index f458e563..7fb04233 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -1,7 +1,14 @@
 #define SU_PATH "/system/bin/su"
 #define SH_PATH "/system/bin/sh"
 
+#ifdef CONFIG_KSU_SUSFS
+// The SUSFS patch declares this as a static key and gates the ksud exec hooks on it too, so it must stay enabled.
+DEFINE_STATIC_KEY_TRUE(ksu_su_compat_enabled);
+static bool ksu_su_compat_switch __read_mostly = true;
+#else
 bool ksu_su_compat_enabled __read_mostly = true;
+#define ksu_su_compat_switch ksu_su_compat_enabled
+#endif
 
 static const char su_path[] = SU_PATH;
 static const char sh_path[] = SH_PATH;
@@ -9,14 +16,14 @@ static const char ksud_path[] = KSUD_PATH;
 
 static int su_compat_feature_get(u64 *value)
 {
-    *value = ksu_su_compat_enabled ? 1 : 0;
+    *value = ksu_su_compat_switch ? 1 : 0;
     return 0;
 }
 
 static int su_compat_feature_set(u64 value)
 {
     bool enable = value != 0;
-    ksu_su_compat_enabled = enable;
+    ksu_su_compat_switch = enable;
     pr_info("su_compat: set to %d\n", enable);
     return 0;
 }
@@ -117,6 +124,9 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
     if (!ksu_handle_execveat_init(filename, (struct user_arg_ptr*)argv_user, (struct user_arg_ptr*)envp_user))
         return -EINVAL;
 
+    if (!ksu_su_compat_switch)
+        return -EINVAL;
+
     if (likely(!__ksu_is_allow_uid_for_current(current_uid().val)))
         return -EINVAL;
 
@@ -182,6 +192,9 @@ int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
 int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode,
              int *__unused_flags)
 {
+    if (!ksu_su_compat_switch)
+        return 0;
+
     if (unlikely(IS_ERR(*filename) || (*filename)->name == NULL))
         return 0;
 
@@ -200,6 +213,9 @@ int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode,
 }
 
 int ksu_handle_stat(int *dfd, struct filename **filename, int *flags) {
+    if (!ksu_su_compat_switch)
+        return 0;
+
     if (unlikely(IS_ERR(*filename) || (*filename)->name == NULL))
         return 0;
 
diff --git a/kernel/feature/sucompat.h b/kernel/feature/sucompat.h
index 4bc74371..ced08c91 100644
--- a/kernel/feature/sucompat.h
+++ b/kernel/feature/sucompat.h
@@ -3,7 +3,12 @@
 #include <asm/ptrace.h>
 #include <linux/types.h>
 
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/jump_label.h>
+DECLARE_STATIC_KEY_TRUE(ksu_su_compat_enabled);
+#else
 extern bool ksu_su_compat_enabled;
+#endif
 
 #ifdef CONFIG_KSU_SUSFS
 int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode, int *__unused_flags);
