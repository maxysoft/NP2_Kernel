Upstream: 54d87b0a0c19bc3f740e4cd4b87ba14ce2e4ea73 ("scsi/scsi_error: Use call_rcu_hurry() instead of call_rcu()")
ACK android13-5.10: 48fcc3fe2017b4592cf547e069bdd80bc15c29c8, taken from arter97/master
Backport notes: call_rcu_flush() renamed to call_rcu_hurry().
---
 drivers/scsi/scsi_error.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/scsi/scsi_error.c b/drivers/scsi/scsi_error.c
index 3d3d139127ee..c02fadcaffce 100644
--- a/drivers/scsi/scsi_error.c
+++ b/drivers/scsi/scsi_error.c
@@ -276,7 +276,7 @@ void scsi_eh_scmd_add(struct scsi_cmnd *scmd)
 	 * Ensure that all tasks observe the host state change before the
 	 * host_failed change.
 	 */
-	call_rcu(&scmd->rcu, scsi_eh_inc_host_failed);
+	call_rcu_hurry(&scmd->rcu, scsi_eh_inc_host_failed);
 }
 
